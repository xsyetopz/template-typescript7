# Bun 1.4.4+ configuration. Reference: https://bun.com/docs/runtime/bunfig

# No `.env` file is loaded, so no developer secret reaches a test, script, or hook.
env = false
telemetry = false

[install]
exact = true
linker = "isolated"
# Never install a missing package while a script runs; `bun install` is the only way in.
auto = "disable"
saveTextLockfile = true

[run]
# Scripts and `#!/usr/bin/env node` binaries (such as oxlint) run on Bun, even where Node.js is installed.
bun = true
# One shell syntax on Linux, macOS, and Windows.
shell = "bun"
noOrphans = true

[test]
randomize = true
coverage = true
coverageSkipTestFiles = true
# The threshold is enforced only while the `text` reporter is on.
coverageReporter = ["text", "lcov"]
coverageThreshold = { lines = 0.9, functions = 0.9 }

[fmt]
useTabs = true
tabWidth = 2
printWidth = 80
semi = true
singleQuote = false
trailingComma = "all"
endOfLine = "lf"
sortImports = true
sortPackageJson = { sortScripts = true }
ignorePatterns = [
	"**/coverage/",
	"**/dist/",
	"**/*.gen.*",
	"**/*.md",
	"**/*.mdx",
]

# YAML cannot use tabs. Markdown is left to markdownlint, which keeps tables compact.
[[fmt.overrides]]
files = ["*.yml", "*.yaml"]
options = { useTabs = false }
