{
	"name": "template-typescript7",
	"version": "0.0.0",
	"private": true,
	"description": "Strictest Bun + TypeScript 7 template.",
	"license": "MIT",
	"author": "xsyetopz",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@types/bun": "1.4.4",
			"@types/node": "26.6.6",
			"markdownlint-cli2": "0.24.0",
			"markdownlint-rule-title-case-style": "0.4.3",
			"oxlint": "1.91.0",
			"oxlint-tsgolint": "7.0.2006",
			"typescript": "7.0.2"
		}
	},
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"guard": "bun-bedrock guard",
		"lint": "bun run --sequential --no-exit-on-error oxlint markdownlint-cli2",
		"lint:fix": "bun run --sequential --no-exit-on-error 'oxlint --fix' 'markdownlint-cli2 --fix'",
		"plugin:validate": "claude plugin validate . && claude plugin validate plugins/bun-bedrock",
		"prepare": "bun-bedrock hooks",
		"test": "bun test --pass-with-no-tests",
		"typecheck": "bun check",
		"verify": "bun run --sequential format:check typecheck lint guard test"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"bun-bedrock": "workspace:*",
		"markdownlint-cli2": "catalog:",
		"markdownlint-rule-title-case-style": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	},
	"overrides": {
		"@types/node": "26.6.6"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4"
}
